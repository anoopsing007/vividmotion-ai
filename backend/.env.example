POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/vividmotion

# AI Video Generation Providers
VIDEO_MODEL_PROVIDER=mock

# Replicate API (https://replicate.com)
REPLICATE_API_KEY=your_replicate_key_here

# Runway API (https://runwayml.com)
RUNWAY_API_KEY=your_runway_key_here

# Stability AI (https://stability.ai)
STABILITY_API_KEY=your_stability_key_here

# OpenAI (for prompt enhancement)
OPENAI_API_KEY=your_openai_key_here

# AWS S3 Storage
S3_BUCKET=vividmotion-videos
S3_REGION=us-east-1
S3_ACCESS_KEY=your_aws_key_here
S3_SECRET_KEY=your_aws_secret_here

# Supabase Alternative
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_key_here

# Redis
REDIS_URL=redis://localhost:6379

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
